# Use segredos diferentes, aleatórios e com pelo menos 32 caracteres.
JWT_ACCESS_SECRET=troque-por-um-segredo-de-acesso-com-32-caracteres
JWT_REFRESH_SECRET=troque-por-outro-segredo-refresh-com-32-caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_DAYS=7

COOKIE_NAME=refreshToken
COOKIE_SAME_SITE=lax

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Usado somente pelo seeder opcional do administrador.
ADMIN_NAME=Administrador
