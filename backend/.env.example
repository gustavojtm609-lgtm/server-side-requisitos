NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=quiz_requisitos
DB_USER=root
DB_PASSWORD=troque_esta_senha
DB_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=0
